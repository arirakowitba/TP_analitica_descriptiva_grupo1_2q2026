+    "    'constitucion': 1,\n",
+    "    'flores': 7,\n",
+    "    'floresta': 10,\n",
+    "    'la boca': 4,\n",
+    "    'liniers': 9,\n",
+    "    'mataderos': 9,\n",
+    "    'monserrat': 1,\n",
+    "    'monte castro': 10,\n",
+    "    'nueva pompeya': 4,\n",
+    "    'nunez': 13,\n",
+    "    'palermo': 14,\n",
+    "    'las canitas': 14,\n",
+    "    'parque avellaneda': 9,\n",
+    "    'parque chacabuco': 7,\n",
+    "    'parque chas': 15,\n",
