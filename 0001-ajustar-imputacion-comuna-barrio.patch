+    "    'paternal': 15,\n",
+    "    'puerto madero': 1,\n",
+    "    'recoleta': 2,\n",
+    "    'retiro': 1,\n",
+    "    'saavedra': 12,\n",
+    "    'san cristobal': 3,\n",
+    "    'san nicolas': 1,\n",
+    "    'san telmo': 1,\n",
+    "    'velez sarsfield': 10,\n",
+    "    'versalles': 10,\n",
+    "    'villa crespo': 15,\n",
+    "    'villa del parque': 11,\n",
+    "    'villa devoto': 11,\n",
+    "    'villa general mitre': 11,\n",
+    "    'villa gral mitre': 11,\n",
+    "    'villa lugano': 8,\n",
+    "    'villa luro': 10,\n",
+    "    'villa ortuzar': 15,\n",
+    "    'villa pueyrredon': 12,\n",
+    "    'villa real': 10,\n",
+    "    'villa riachuelo': 8,\n",
+    "    'villa santa rita': 11,\n",
+    "    'villa soldati': 8,\n",
+    "    'villa urquiza': 12,\n",
+    "}\n",
+    "\n",
+    "# Aliases controlados: algunas fuentes llegan con separadores distintos luego de la normalización inicial.\n",
+    "BARRIO_A_COMUNA.update({\n",
+    "    key.replace(' ', '_'): value\n",
+    "    for key, value in list(BARRIO_A_COMUNA.items())\n",
+    "})\n",
+    "\n",
+    "\n",
+    "def imputar_comuna_por_barrio(df):\n",
+    "    out = df.copy()\n",
+    "\n",
+    "    if 'barrio_norm' not in out.columns:\n",
+    "        return out, {\n",
+    "            'barrio_norm_no_nulos': np.nan,\n",
+    "            'barrios_reconocidos': 0,\n",
+    "            'n_nulos_antes': np.nan,\n",
+    "            'n_imputados': 0,\n",
+    "            'n_nulos_despues': np.nan,\n",
+    "            'criterio': 'no_aplica_por_barrio_norm_faltante',\n",
+    "        }\n",
+    "\n",
+    "    # Si la fuente no trae comuna, se crea para poder reconstruirla solo en casos confiables.\n",
+    "    if 'comuna' not in out.columns:\n",
+    "        out['comuna'] = np.nan\n",
+    "\n",
+    "    barrio_norm = out['barrio_norm'].astype('string')\n",
+    "    comuna_original = pd.to_numeric(out['comuna'], errors='coerce')\n",
+    "    comuna_por_barrio = barrio_norm.map(BARRIO_A_COMUNA)\n",
+    "\n",
+    "    barrio_norm_no_nulos = int(barrio_norm.notna().sum())\n",
+    "    barrios_reconocidos = int(comuna_por_barrio.notna().sum())\n",
+    "    # Solo se completan nulos y solo cuando barrio_norm mapea contra un barrio oficial/alias controlado.\n",
+    "    mask_imputar = comuna_original.isna() & comuna_por_barrio.notna()\n",
+    "\n",
+    "    out['comuna'] = comuna_original\n",
+    "    out.loc[mask_imputar, 'comuna'] = comuna_por_barrio.loc[mask_imputar]\n",
+    "\n",
+    "    return out, {\n",
+    "        'barrio_norm_no_nulos': barrio_norm_no_nulos,\n",
+    "        'barrios_reconocidos': barrios_reconocidos,\n",
+    "        'pct_barrios_reconocidos': round(barrios_reconocidos / barrio_norm_no_nulos * 100, 2) if barrio_norm_no_nulos else 0,\n",
+    "        'n_nulos_antes': int(comuna_original.isna().sum()),\n",
+    "        'n_imputados': int(mask_imputar.sum()),\n",
+    "        'n_nulos_despues': int(out['comuna'].isna().sum()),\n",
+    "        'criterio': 'barrio_norm -> comuna oficial CABA',\n",
+    "    }\n",
+    "\n",
+    "\n",
+    "reportes_imputacion_comuna = []\n",
+    "\n",
+    "for name, df in list(preprocesados.items()):\n",
+    "    df_imputado, reporte = imputar_comuna_por_barrio(df)\n",
+    "    preprocesados[name] = df_imputado\n",
+    "    globals()[name] = df_imputado\n",
+    "\n",
+    "    reportes_imputacion_comuna.append({\n",
+    "        'dataframe': name,\n",
+    "        'variable': 'comuna',\n",
+    "        **reporte,\n",
+    "    })\n",
+    "\n",
+    "reporte_imputacion_comuna = pd.DataFrame(reportes_imputacion_comuna)\n",
+    "display(reporte_imputacion_comuna)\n",
+    "reporte_imputacion_comuna.to_csv(REPORTS_DIR / 'imputacion_comuna_por_barrio_v1.csv', index=False)\n",
+    "\n"
+   ]
+  },
