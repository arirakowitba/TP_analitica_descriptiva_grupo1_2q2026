+        "            'pct_invalidos': round(out[invalid_flag].mean() * 100, 2),\n",
+        "            'pct_outliers_p01_p99': round(out[outlier_flag].mean() * 100, 2),\n",
+        "        })\n",
+        "\n",
+        "    return out, pd.DataFrame(rows)"
+      ]
+    },
+    {
+      "cell_type": "markdown",
+      "metadata": {},
+      "source": [
+        "## Aplicación por dataset"
