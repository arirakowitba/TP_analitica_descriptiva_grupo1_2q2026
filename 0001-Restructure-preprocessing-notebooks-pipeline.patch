+        "\n",
+        "    if ELIMINAR_OUTLIERS_P01_P99 and outlier_flags:\n",
+        "        df = df.loc[~df[outlier_flags].any(axis=1)].copy()\n",
+        "\n",
+        "    preprocesados_con_outliers[name] = df\n",
+        "    resumen_decisiones_outliers.append({\n",
