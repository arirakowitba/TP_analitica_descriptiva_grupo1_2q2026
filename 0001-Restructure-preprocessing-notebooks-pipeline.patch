+        "    if NULIFICAR_VALORES_INVALIDOS:\n",
+        "        for flag_col in invalid_flags:\n",
+        "            base_col = flag_col.replace('_valor_invalido_flag', '')\n",
+        "            if base_col in df.columns:\n",
