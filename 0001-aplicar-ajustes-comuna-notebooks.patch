+"""Ajustes idempotentes de comuna en notebooks 02 y 07.
+
+Uso:
+    python tools/aplicar_ajustes_comuna_notebooks.py
+
+El script edita los notebooks existentes por contenido, no por numero de linea.
+Esto evita que fallen parches directos sobre .ipynb cuando cambiaron outputs,
+metadata o el formato interno del JSON.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+MD_COMUNA_NB02 = """### Imputación determinística de comuna por barrio
+
+Cuando `comuna` falta pero `barrio_norm` está disponible y coincide con un barrio oficial de CABA, se completa usando la correspondencia barrio-comuna. Si la columna `comuna` no existe todavía, se crea. No es una imputación estadística: se reconstruye una variable territorial a partir de otra más granular y fija.
+
+**Comentarios y limitaciones:**
+- La regla se aplica solo cuando `barrio_norm` coincide con un barrio oficial o con un alias controlado, como `las canitas` -> Palermo / Comuna 14.
+- No se fuerza la imputación cuando `barrio_norm` parece contener calles, direcciones u otras referencias no barriales. Esto evita asignar comunas con supuestos débiles.
+- El reporte muestra qué proporción de `barrio_norm` fue reconocida como barrio oficial para auditar la calidad de la reconstrucción por fuente.
+- Los casos que sigan sin `comuna` quedan identificados para una etapa posterior de enriquecimiento territorial. En el notebook 7 se podrán completar con coordenadas, geocodificación o cruce espacial cuando corresponda.
+"""
+
+
+CODE_COMUNA_NB02 = """BARRIO_A_COMUNA = {
+    'agronomia': 15,
+    'almagro': 5,
+    'balvanera': 3,
+    'barracas': 4,
+    'belgrano': 13,
+    'boedo': 5,
+    'caballito': 6,
+    'chacarita': 15,
+    'coghlan': 12,
+    'colegiales': 13,
+    'constitucion': 1,
+    'flores': 7,
+    'floresta': 10,
+    'la boca': 4,
+    'liniers': 9,
+    'mataderos': 9,
+    'monserrat': 1,
+    'monte castro': 10,
+    'nueva pompeya': 4,
+    'nunez': 13,
+    'palermo': 14,
+    'las canitas': 14,
+    'parque avellaneda': 9,
+    'parque chacabuco': 7,
+    'parque chas': 15,
+    'parque patricios': 4,
+    'paternal': 15,
+    'puerto madero': 1,
+    'recoleta': 2,
+    'retiro': 1,
+    'saavedra': 12,
+    'san cristobal': 3,
+    'san nicolas': 1,
+    'san telmo': 1,
+    'velez sarsfield': 10,
+    'versalles': 10,
+    'villa crespo': 15,
+    'villa del parque': 11,
+    'villa devoto': 11,
+    'villa general mitre': 11,
+    'villa gral mitre': 11,
+    'villa lugano': 8,
+    'villa luro': 10,
+    'villa ortuzar': 15,
+    'villa pueyrredon': 12,
+    'villa real': 10,
+    'villa riachuelo': 8,
+    'villa santa rita': 11,
+    'villa soldati': 8,
+    'villa urquiza': 12,
+}
+
+# Aliases controlados: algunas fuentes llegan con separadores distintos luego de la normalización inicial.
+BARRIO_A_COMUNA.update({
+    key.replace(' ', '_'): value
+    for key, value in list(BARRIO_A_COMUNA.items())
+})
+
+
+def imputar_comuna_por_barrio(df):
+    out = df.copy()
+
+    if 'barrio_norm' not in out.columns:
+        return out, {
+            'barrio_norm_no_nulos': np.nan,
+            'barrios_reconocidos': 0,
+            'n_nulos_antes': np.nan,
+            'n_imputados': 0,
+            'n_nulos_despues': np.nan,
+            'criterio': 'no_aplica_por_barrio_norm_faltante',
+        }
+
+    # Si la fuente no trae comuna, se crea para poder reconstruirla solo en casos confiables.
+    if 'comuna' not in out.columns:
+        out['comuna'] = np.nan
+
+    barrio_norm = out['barrio_norm'].astype('string')
+    comuna_original = pd.to_numeric(out['comuna'], errors='coerce')
+    comuna_por_barrio = barrio_norm.map(BARRIO_A_COMUNA)
+
+    barrio_norm_no_nulos = int(barrio_norm.notna().sum())
+    barrios_reconocidos = int(comuna_por_barrio.notna().sum())
+    # Solo se completan nulos y solo cuando barrio_norm mapea contra un barrio oficial/alias controlado.
+    mask_imputar = comuna_original.isna() & comuna_por_barrio.notna()
+
+    out['comuna'] = comuna_original
+    out.loc[mask_imputar, 'comuna'] = comuna_por_barrio.loc[mask_imputar]
+
+    return out, {
+        'barrio_norm_no_nulos': barrio_norm_no_nulos,
+        'barrios_reconocidos': barrios_reconocidos,
+        'pct_barrios_reconocidos': round(barrios_reconocidos / barrio_norm_no_nulos * 100, 2) if barrio_norm_no_nulos else 0,
+        'n_nulos_antes': int(comuna_original.isna().sum()),
+        'n_imputados': int(mask_imputar.sum()),
+        'n_nulos_despues': int(out['comuna'].isna().sum()),
+        'criterio': 'barrio_norm -> comuna oficial CABA',
+    }
+
+
+reportes_imputacion_comuna = []
+
+for name, df in list(preprocesados.items()):
+    df_imputado, reporte = imputar_comuna_por_barrio(df)
+    preprocesados[name] = df_imputado
+    globals()[name] = df_imputado
+
+    reportes_imputacion_comuna.append({
+        'dataframe': name,
+        'variable': 'comuna',
+        **reporte,
+    })
+
+reporte_imputacion_comuna = pd.DataFrame(reportes_imputacion_comuna)
+display(reporte_imputacion_comuna)
+reporte_imputacion_comuna.to_csv(REPORTS_DIR / 'imputacion_comuna_por_barrio_v1.csv', index=False)
+"""
+
+
+MD_COMUNA_NB07 = """### Recuperación territorial pendiente por coordenadas
+
+En el notebook 02 se completa `comuna` cuando `barrio_norm` coincide con un barrio oficial. En esta etapa se agrega un segundo control: si después del cruce de ubicación todavía faltan `barrio_oficial` o `comuna_oficial`, se intenta recuperarlos con las coordenadas (`lat`, `lon`) y los polígonos oficiales de barrios.
+
+Esta recuperación sigue siendo determinística: no estima comuna por similitud ni por distribución estadística, sino por pertenencia espacial del punto a un barrio oficial. Los casos que queden sin completar se mantienen como faltantes para no forzar publicaciones sin coordenadas, con coordenadas fuera de CABA o con geocodificación insuficiente.
+"""
+
+
+CODE_COMUNA_NB07 = """# Recuperación de barrio/comuna por coordenadas cuando el texto no alcanzó.
+barrios_lookup = barrios.set_index('barrio_oficial')['comuna']
+
+barrio_por_coord = geo.asignar_barrio(df['lat'], df['lon'], barrios)
+comuna_por_coord = barrio_por_coord.map(barrios_lookup)
+
+mask_barrio_coord = df['barrio_oficial'].isna() & barrio_por_coord.notna()
+mask_comuna_coord = df['comuna_oficial'].isna() & comuna_por_coord.notna()
+
+df.loc[mask_barrio_coord, 'barrio_oficial'] = barrio_por_coord.loc[mask_barrio_coord]
+df.loc[mask_barrio_coord, 'origen_barrio'] = 'coordenadas'
+df.loc[mask_comuna_coord, 'comuna_oficial'] = comuna_por_coord.loc[mask_comuna_coord]
+
+reporte_recuperacion_territorial = pd.DataFrame([
+    {
+        'variable': 'barrio_oficial',
+        'criterio': 'punto dentro de poligono de barrio oficial',
+        'n_recuperados': int(mask_barrio_coord.sum()),
+        'n_faltantes_restantes': int(df['barrio_oficial'].isna().sum()),
+    },
+    {
+        'variable': 'comuna_oficial',
+        'criterio': 'comuna del barrio oficial asignado por coordenadas',
+        'n_recuperados': int(mask_comuna_coord.sum()),
+        'n_faltantes_restantes': int(df['comuna_oficial'].isna().sum()),
+    },
+])
+
+display(reporte_recuperacion_territorial)
+"""
+
+
+def read_nb(path: Path) -> dict:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def write_nb(path: Path, nb: dict) -> None:
+    path.write_text(json.dumps(nb, ensure_ascii=False, indent=1), encoding="utf-8")
+
+
+def source(cell: dict) -> str:
+    return "".join(cell.get("source", []))
+
+
+def set_source(cell: dict, text: str) -> None:
+    cell["source"] = text.splitlines(keepends=True)
+
+
+def make_cell(cell_type: str, text: str) -> dict:
+    cell = {
+        "cell_type": cell_type,
+        "metadata": {},
+        "source": text.splitlines(keepends=True),
+    }
+    if cell_type == "code":
+        cell.update({"execution_count": None, "outputs": []})
+    return cell
+
+
+def find_cell(nb: dict, predicate) -> int | None:
+    for idx, cell in enumerate(nb["cells"]):
+        if predicate(cell, source(cell)):
+            return idx
+    return None
+
+
+def insert_after_anchor(nb: dict, anchor_text: str, new_cells: list[dict]) -> None:
+    anchor_idx = find_cell(nb, lambda _c, s: anchor_text in s)
+    if anchor_idx is None:
+        nb["cells"].extend(new_cells)
+        return
+    nb["cells"][anchor_idx + 1:anchor_idx + 1] = new_cells
+
+
+def update_nb02() -> None:
+    path = REPO_ROOT / "notebooks" / "02_normalizacion_y_limpieza.ipynb"
+    nb = read_nb(path)
+
+    md_idx = find_cell(nb, lambda c, s: c["cell_type"] == "markdown" and "Imputación determinística de comuna por barrio" in s)
+    code_idx = find_cell(nb, lambda c, s: c["cell_type"] == "code" and "def imputar_comuna_por_barrio" in s)
+
+    if md_idx is not None:
+        set_source(nb["cells"][md_idx], MD_COMUNA_NB02)
+    if code_idx is not None:
+        set_source(nb["cells"][code_idx], CODE_COMUNA_NB02)
+
+    if md_idx is None and code_idx is None:
+        insert_after_anchor(
+            nb,
+            "Normalización por fuente y operación",
+            [make_cell("markdown", MD_COMUNA_NB02), make_cell("code", CODE_COMUNA_NB02)],
+        )
+
+    decisiones_idx = find_cell(nb, lambda c, s: c["cell_type"] == "code" and "decisiones_limpieza = pd.DataFrame" in s)
+    if decisiones_idx is not None:
+        s = source(nb["cells"][decisiones_idx])
+        if "Comuna por barrio" not in s:
+            needle = "{'tema': 'Barrios', 'decision': 'Crear barrio_norm con limpieza de tildes, aliases y subzonas', 'justificacion': 'Permite cruces territoriales sin perder el valor original.'},"
+            replacement = needle + "\n    {'tema': 'Comuna por barrio', 'decision': 'Completar comuna faltante con barrio_norm cuando existe correspondencia oficial', 'justificacion': 'Es una reconstrucción determinística barrio-comuna; mejora análisis territoriales sin introducir supuestos estadísticos.'},"
+            s = s.replace(needle, replacement)
+            set_source(nb["cells"][decisiones_idx], s)
+
+    write_nb(path, nb)
+
+
+def update_nb07() -> None:
+    path = REPO_ROOT / "notebooks" / "07_feature_engineering.ipynb"
+    nb = read_nb(path)
+
+    md_idx = find_cell(nb, lambda c, s: c["cell_type"] == "markdown" and "Recuperación territorial pendiente por coordenadas" in s)
+    code_idx = find_cell(nb, lambda c, s: c["cell_type"] == "code" and "reporte_recuperacion_territorial" in s)
+
+    if md_idx is not None:
+        set_source(nb["cells"][md_idx], MD_COMUNA_NB07)
+    if code_idx is not None:
+        set_source(nb["cells"][code_idx], CODE_COMUNA_NB07)
+
+    if md_idx is None and code_idx is None:
+        # Va despues de cargar y unir base + ubicación, antes de calcular variables externas.
+        insert_after_anchor(
+            nb,
+            "## 5. Entorno urbano por publicación",
+            [make_cell("markdown", MD_COMUNA_NB07), make_cell("code", CODE_COMUNA_NB07)],
+        )
+
+    write_nb(path, nb)
+
+
+def main() -> None:
+    update_nb02()
+    update_nb07()
+    print("OK: notebooks 02 y 07 actualizados.")
+
+
+if __name__ == "__main__":
+    main()
